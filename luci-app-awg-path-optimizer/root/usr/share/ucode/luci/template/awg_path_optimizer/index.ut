{% include('header', { }) %}
<meta http-equiv="refresh" content="10" />
<div class="cbi-map">
	<h2 name="content">{{ _('AWG Path Optimizer') }}</h2>
	<p>{{ _('Service status:') }} <strong>{{ running ? _('running') : _('stopped') }}</strong></p>
	{% if (message): %}
		<div class="alert-message">{{ entityencode(message) }}</div>
	{% endif %}
	<div class="cbi-page-actions">
		<form method="post" action="{{ entityencode(action_base) }}" style="display:inline">
			<input type="hidden" name="token" value="{{ entityencode(ctx.authtoken) }}" />
			<input type="hidden" name="action" value="start" />
			<input class="cbi-button cbi-button-apply" type="submit" value="{{ _('Start') }}" />
		</form>
		<form method="post" action="{{ entityencode(action_base) }}" style="display:inline">
			<input type="hidden" name="token" value="{{ entityencode(ctx.authtoken) }}" />
			<input type="hidden" name="action" value="stop" />
			<input class="cbi-button cbi-button-reset" type="submit" value="{{ _('Stop') }}" />
		</form>
		<form method="post" action="{{ entityencode(action_base) }}" style="display:inline">
			<input type="hidden" name="token" value="{{ entityencode(ctx.authtoken) }}" />
			<input type="hidden" name="action" value="recheck" />
			<input class="cbi-button cbi-button-action" type="submit" value="{{ _('Force recheck') }}" />
		</form>
	</div>
	<div class="cbi-section">
		<legend>{{ _('Interfaces') }}</legend>
		<div class="table cbi-section-table">
			<div class="tr table-titles">
				<div class="th">{{ _('Interface') }}</div>
				<div class="th">{{ _('Listen port') }}</div>
				<div class="th">{{ _('First peer endpoint') }}</div>
				<div class="th">{{ _('Change port') }}</div>
			</div>
			{% for (let iface in interfaces): %}
				<div class="tr cbi-section-table-row">
					<div class="td">{{ entityencode(iface.name) }}</div>
					<div class="td">{{ entityencode(iface.port) }}</div>
					<div class="td">{{ entityencode(iface.endpoint) }}</div>
					<div class="td">
						<form method="post" action="{{ entityencode(action_base) }}">
							<input type="hidden" name="token" value="{{ entityencode(ctx.authtoken) }}" />
							<input type="hidden" name="action" value="set-port" />
							<input type="hidden" name="iface" value="{{ entityencode(iface.name) }}" />
							<input type="number" name="port" min="1" max="65535" value="{{ entityencode(iface.port) }}" />
							<input class="cbi-button cbi-button-action" type="submit" value="{{ _('Set') }}" />
						</form>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
	<div class="cbi-section">
		<legend>{{ _('Recent log') }}</legend>
		<pre>{{ entityencode(recent_log || '-') }}</pre>
	</div>
</div>
{% include('footer') %}
